############################################################
# .env.example
# Copy to .env and fill real secrets locally.
############################################################

# Flask / Core
FLASK_ENV=development
PORT=5001
FLASK_SECRET_KEY=replace_with_secure_random_hex

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=advdb
DB_USER=advuser
DB_PASSWORD=your_db_password

# Multi-tenancy
MULTI_TENANT=0
DEFAULT_TENANT_ID=public

# Metrics / Feature Flags
METRICS_ENABLED=1

# OpenAI / LLM (leave blank if not using)
OPENAI_API_KEY=CHAVE_AQUI
OPENAI_MODEL=gpt-4o-mini

# Vector Store
CHROMA_PERSIST_DIR=.chroma

# Logging
LOG_LEVEL=INFO

# Legacy internal host
INTERNAL_API_HOST=127.0.0.1

# Timezone
TZ=UTC

# Notes:
# 1. Never commit the populated .env to VCS.
# 2. Generate a secure FLASK_SECRET_KEY before deploying.
############################################################
# .env.example
# Copy to .env and fill real secrets locally.
############################################################

# Flask / Core
FLASK_ENV=development
PORT=5001
FLASK_SECRET_KEY=replace_with_secure_random_hex

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=advdb
DB_USER=advuser
DB_PASSWORD=probe365

# Multi-tenancy
MULTI_TENANT=0
DEFAULT_TENANT_ID=public

# Metrics / Feature Flags
METRICS_ENABLED=1

# OpenAI / LLM (leave blank if not using)
OPENAI_API_KEY=CHAVE_AQUI
OPENAI_MODEL=gpt-4o-mini

# Vector Store
CHROMA_PERSIST_DIR=.chroma

# Logging
LOG_LEVEL=INFO

# Legacy internal host
INTERNAL_API_HOST=127.0.0.1

# Timezone
TZ=UTC

############################################################
# SMTP Configuration (for Email Notifications)
# See EMAIL_CONFIG_GUIDE.md for detailed instructions
############################################################

# Gmail Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_from_google
EMAIL_FROM=your_email@gmail.com
SMTP_USE_TLS=true

# Alternative: Outlook
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=your_email@outlook.com
# SMTP_PASSWORD=your_password
# EMAIL_FROM=your_email@outlook.com
# SMTP_USE_TLS=true

# Alternative: SendGrid (Recommended for Production)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=noreply@yourdomain.com
# SMTP_USE_TLS=true

# Alternative: Mailgun
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@yourdomain.mailgun.org
# SMTP_PASSWORD=your_mailgun_password
# EMAIL_FROM=noreply@yourdomain.mailgun.org
# SMTP_USE_TLS=true

# Development/Testing: Mailtrap
# SMTP_HOST=live.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=your_mailtrap_user
# SMTP_PASSWORD=your_mailtrap_password
# EMAIL_FROM=your_email@mailtrap.io
# SMTP_USE_TLS=true

# Notes:
# 1. Never commit the populated .env to VCS.
# 2. Generate a secure FLASK_SECRET_KEY before deploying.
# 3. Set OPENAI_API_KEY only if AI features used.
# 4. For SMTP_PASSWORD with Gmail:
#    - Go to https://myaccount.google.com/apppasswords
#    - Generate an app password (16 chars with spaces)
#    - Copy the entire string here (including spaces)
# 5. See EMAIL_CONFIG_GUIDE.md for detailed SMTP setup instructions

############################################################
# DJE / CNJ Integration
############################################################
# Base URL do Gateway DJE (CNJ)
DJE_BASE_URL=https://gateway.cloud.pje.jus.br/domicilio-eletronico

# Autenticação (use apenas o que for exigido pela sua conta)
DJE_API_KEY=
DJE_TOKEN=
DJE_CLIENT_ID=
DJE_CLIENT_SECRET=

# Endpoints (paths relativos ou URLs completas)
# Exemplo (ajuste conforme sua documentação):
# DJE_PUSH_SUBSCRIBE_PATH=/api/v1/assinaturas
# DJE_PUSH_EVENTS_PATH=/api/v1/notificacoes
# DJE_ANDAMENTOS_PATH=/api/v1/andamentos
# DJE_INTEIRO_TEOR_PATH=/api/v1/processos/{numeroProcesso}/comunicacoes/{numeroComunicacao}
DJE_PUSH_SUBSCRIBE_PATH=
DJE_PUSH_EVENTS_PATH=
DJE_ANDAMENTOS_PATH=
DJE_INTEIRO_TEOR_PATH=

# Webhook para recebimento de notificações PUSH
DJE_PUSH_CALLBACK_URL=https://SEU_DOMINIO/dje/webhook/push
DJE_WEBHOOK_SECRET=

# Webhook para recebimento de e-mails (TJSP)
DJE_EMAIL_WEBHOOK_SECRET=

# Timeout (segundos)
DJE_TIMEOUT=20

############################################################
# IMAP (Locaweb) - Ingestão de e-mails do TJSP
############################################################
IMAP_HOST=email-ssl.com.br
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_SSL=true
IMAP_PROCESSED_MAILBOX=Processed
IMAP_USE_UNSEEN=true

# Para rodar scripts por tenant
TENANT_ID=public

